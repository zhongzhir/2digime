{
  "name": "digitalme-v2",
  "version": "0.3.0",
  "description": "Digital Me — an Owner-controlled, AI-native personal digital subject system.",
  "type": "commonjs",
  "author": "Digital Me",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node dist/smoke.js",
    "test": "node --test --test-concurrency=1 \"dist/infrastructure/tests/*.test.js\" \"dist/identity/tests/*.test.js\" \"dist/work-runtime/tests/*.test.js\" \"dist/subject-core/tests/*.test.js\" \"dist/intelligence/tests/*.test.js\" \"dist/capability/adapters/tests/*.test.js\" \"dist/capability/tests/*.test.js\" \"dist/runtime/tests/*.test.js\" \"dist/engineering/tests/*.test.js\" \"dist/collaboration/tests/*.test.js\" \"dist/subject-comm/tests/*.test.js\" \"dist/execution/tests/*.test.js\"",
    "electron:version": "node scripts/check-electron-version.cjs",
    "preflight:electron": "node scripts/electron-preflight.cjs",
    "dev": "node scripts/start-dev.cjs",
    "build:packaged": "node scripts/build-packaged.cjs",
    "brand:validate": "node institution/brand-kit/validate.cjs",
    "brand:verify": "node institution/brand-kit/run-verify.cjs",
    "institution:accept": "node institution/acceptance-e/run-acceptance.cjs",
    "institution:partner:verify": "npm run build && node institution/partner-sandbox/run-verify.cjs",
    "identity:oidc:verify": "node institution/identity-sandbox/oidc-provider/run-verify.cjs",
    "identity:oidc:external:verify": "node institution/identity-sandbox/duende-demo/run-verify.cjs",
    "identity:oidc:auth0:verify": "node institution/identity-sandbox/auth0/run-verify.cjs",
    "smoke:packaged": "node scripts/run-packaged-trial-smoke.cjs",
    "test:model-gate": "node scripts/test-model-gate-visibility.cjs",
    "benchmark:office": "npm run build && node scripts/run-office-benchmark.cjs",
    "benchmark:coding:preflight": "node scripts/preflight-slice-2c-coding-benchmark.cjs",
    "benchmark:coding:evidence": "npm run build && node scripts/check-slice-2c-coding-evidence.cjs",
    "benchmark:coding:collector": "node scripts/slice-2c-coding-collector.cjs",
    "benchmark:coding:codex-direct": "node scripts/run-slice-2c-codex-direct.cjs",
    "verify": "npm run build && npm run smoke && npm run test && npm run test:model-gate && npm run preflight:electron"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "docx": "9.7.1",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "jose": "^6.2.18",
    "node-html-parser": "^9.0.4",
    "openid-client": "^6.9.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "0.20.2",
    "pptxgenjs": "4.0.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.7",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "oidc-provider": "^9.15.1",
    "playwright": "^1.65.1",
    "rcedit": "^5.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
