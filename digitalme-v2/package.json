{
  "name": "digitalme-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Me V2 — personal digital subject system (clean-slate implementation)",
  "type": "commonjs",
  "author": "Digital Me",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node dist/smoke.js",
    "test": "node --test --test-concurrency=1 \"dist/infrastructure/tests/*.test.js\" \"dist/work-runtime/tests/*.test.js\" \"dist/subject-core/tests/*.test.js\" \"dist/capability/adapters/tests/*.test.js\" \"dist/runtime/tests/*.test.js\"",
    "electron:version": "node scripts/check-electron-version.cjs",
    "preflight:electron": "node scripts/electron-preflight.cjs",
    "dev": "node scripts/start-dev.cjs",
    "accept:dev": "node scripts/run-p15-dev-acceptance.cjs",
    "build:packaged": "node scripts/build-packaged.cjs",
    "accept:packaged": "node scripts/run-packaged-acceptance.cjs",
    "smoke:packaged": "node scripts/run-packaged-smoke.cjs",
    "verify": "npm run build && npm run smoke && npm run test && npm run preflight:electron"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3"
  }
}
