{
  "name": "digitalme-app",
  "version": "0.1.0",
  "description": "Digital Me 本地桌面应用：加载个人 Digital Me Package，以 AI 为底座完成'像我'的任务。",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:p1-01": "node scripts/test-p1-01-secret-store.cjs && node scripts/test-p1-01-secret-leak-scan.cjs",
    "test:p1-02": "node scripts/test-p1-02-package-store.cjs",
    "test:p1-03": "node scripts/test-p1-03-subject-overview.cjs",
    "test:settings-temp-package": "node scripts/test-settings-temp-package.cjs",
    "test:p1-04": "node scripts/test-p1-04-policy-decision-audit.cjs",
    "test:p1-05": "node scripts/test-p1-05-tool-broker.cjs && node scripts/test-p1-05-stop-ipc.cjs",
    "test:p1-06": "node scripts/test-p1-06-builder-package-store.cjs",
    "test:p1-07": "node scripts/test-p1-07-life-identity-package-store.cjs",
    "test:p1-07-owner-runtime": "electron scripts/electron-p1-07-owner-runtime-test.cjs",
    "test:pan-01": "node scripts/test-pan-01-product-panorama.cjs",
    "test:pan-01-owner-runtime": "electron scripts/electron-pan-01-owner-runtime-test.cjs",
    "test:pan-01r": "node scripts/test-pan-01r-sovereign-collaboration.cjs",
    "test:pan-01r-owner-runtime": "electron scripts/electron-pan-01r-owner-runtime-test.cjs",
    "test:pan-01s": "node scripts/test-pan-01s-minimal-surface.cjs",
    "test:pan-01s-owner-runtime": "electron scripts/electron-pan-01s-owner-runtime-test.cjs",
    "test:p1-baseline-real": "node scripts/test-p1-baseline-real.cjs",
    "test:bootstrap-submit": "node scripts/test-bootstrap-file-submit.cjs && node scripts/test-renderer-ui-bindings.cjs",
    "test:chat-history-display": "node scripts/test-chat-history-display.cjs && node scripts/test-session-overflow-menu.cjs",
    "test:act-behalf": "node scripts/test-act-behalf-contracts.cjs",
    "test:cli": "node scripts/test-cli.cjs",
    "test:cli-enhanced": "node scripts/test-cli-enhanced.cjs",
    "test:mcp-server": "node scripts/test-mcp-server.cjs",
    "test:editor-extension": "node scripts/test-editor-extension.cjs",
    "test:classic-renderer-dom": "electron scripts/test-classic-renderer-dom-structure.cjs",
    "test:vl1-block1": "node scripts/test-vl1-block1-context-assembly.cjs",
    "test:vl1-claim-granularity": "node scripts/test-vl1-claim-granularity.cjs",
    "test:vl1-block2": "node scripts/test-vl1-block2-research-invocation.cjs",
    "test:vl1-block3": "node scripts/test-vl1-block3-result-generation.cjs",
    "test:vl1-block4": "node scripts/test-vl1-block4-experience-proposal.cjs",
    "test:gate4-auto-flow": "node scripts/test-gate4-auto-flow.cjs",
    "test:r2-contracts": "node scripts/test-r2-contracts.cjs",
    "test:owner-runtime": "electron scripts/electron-owner-runtime-test.cjs",
    "test:visual-acceptance": "electron scripts/electron-visual-acceptance.cjs",
    "test:capability-acceptance": "electron scripts/electron-capability-acceptance.cjs",
    "test:model-routing": "node scripts/test-model-routing.cjs",
    "test:model-routing-acceptance": "electron scripts/electron-model-routing-acceptance.cjs",
    "test:distill-me": "node scripts/test-distill-me.cjs",
    "test:distill-me-acceptance": "electron scripts/electron-distill-me-acceptance.cjs",
    "test:doing-context-acceptance": "electron scripts/electron-doing-context-acceptance.cjs",
    "test:r1-entry": "node scripts/test-r1-renderer-entry.cjs",
    "test:r1-spike": "npm run typecheck:renderer-next && npm run build:renderer-next && npm run test:r1-entry && npx playwright test -c playwright.config.cjs --project=r1-spike",
    "test:r2-e2e": "npm run typecheck:renderer-next && npm run build:renderer-next && npx playwright test -c playwright.config.cjs --project=r2-chat-sessions",
    "test:r2": "npm run test:r2-contracts && npm run test:r2-e2e",
    "test:r2-dialogue": "node scripts/test-r2-dialogue.cjs",
    "build:renderer-next": "vite build --config src/renderer-next/vite.config.ts",
    "typecheck:renderer-next": "tsc -p src/renderer-next/tsconfig.json --noEmit",
    "dev:renderer-next": "vite --config src/renderer-next/vite.config.ts",
    "test:p1-phase1": "npm run test:p1-01 && npm run test:p1-02 && npm run test:p1-03 && npm run test:settings-temp-package && npm run test:p1-04 && npm run test:p1-05 && npm run test:p1-06 && npm run test:p1-07 && npm run test:bootstrap-submit && npm run test:owner-runtime",
    "test:email-draft": "node scripts/test-email-draft.cjs",
    "test:video-audio": "node scripts/test-video-audio.cjs",
    "test:id-01-identity": "node scripts/test-id-01-identity.cjs",
    "test:id-02-role-view": "node scripts/test-id-02-role-view.cjs",
    "test:id-03-vc-credential": "node scripts/test-id-03-vc-credential.cjs",
    "test:id-04-credential-flow": "node scripts/test-id-04-credential-flow.cjs",
    "test:id-05-collaboration": "node scripts/test-id-05-collaboration.cjs",
    "test:credential-exchange": "node scripts/test-credential-exchange.cjs",
    "test:collaboration-exchange": "node scripts/test-collaboration-exchange.cjs"
  },
  "keywords": [
    "digital-me",
    "personal-ai",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^32.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vite": "5.4.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1"
  }
}
