# Relay（公网部署）
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DATA_DIR=/var/lib/digitalme-relay

# 不要把本服务直接暴露到公网。由 Caddy / Nginx 在 443 终止 TLS 后反代到上方端口。
# Owner 只需要：https://<your-domain>

# WEB_DISCOVERY managed provider secret — 只放服务器 env，不要进 git / 安装包 / 前端。
# 普通用户不需要、也不应该配置这个密钥。
# 中国默认：aliyun-iqs（IQS UnifiedSearch HTTP Bearer API Key，不经 Google，不要求 OpenSearch）。
WEB_DISCOVERY_PROVIDER=aliyun-iqs
WEB_DISCOVERY_PROVIDER_API_KEY=
# 可选覆盖；默认 https://cloud-iqs.aliyuncs.com/search/unified
# WEB_DISCOVERY_PROVIDER_ENDPOINT=
# OpenSearch 仍是可选 provider。未配置 workspace / secret / endpoint 时不得影响默认启动。
# WEB_DISCOVERY_PROVIDER_WORKSPACE=default
# WEB_DISCOVERY_PROVIDER_SERVICE_ID=ops-web-search-001
# WEB_DISCOVERY_PROVIDER_MODEL=
# 仅 WEB_DISCOVERY_PROVIDER=gemini 时使用；不得当作 IQS Key。
# GEMINI_API_KEY=

# MANAGED AI — server-only DeepSeek（或兼容）凭证。禁止进 git / 安装包 / 前端 / 客户端 SecretStore。
# 普通用户不配置这个 Key。
MANAGED_AI_PROVIDER=deepseek
MANAGED_AI_PROVIDER_API_KEY=
MANAGED_AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
MANAGED_AI_PROVIDER_MODEL=deepseek-v4-flash
# 一次性试用额度，可配置，不是永久商业承诺。
MANAGED_AI_TRIAL_TOKEN_LIMIT=5000000
MANAGED_AI_GLOBAL_TOKEN_CEILING=50000000
MANAGED_AI_GLOBAL_DAILY_REQUESTS=2000
MANAGED_AI_PER_PRINCIPAL_PER_HOUR=30
MANAGED_AI_MAX_OUTPUT_TOKENS=2048
MANAGED_AI_MAX_INPUT_CHARS=100000
MANAGED_AI_CONCURRENCY=8
MANAGED_AI_TIMEOUT_MS=90000

