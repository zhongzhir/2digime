--- a/review/core-link-02/DEPLOY-AFTER-APPROVAL.sh
+++ b/review/core-link-02/DEPLOY-AFTER-APPROVAL.sh
@@ -3 +3 @@
-set -euo pipefail
+set -Eeuo pipefail
@@ -6,0 +7,17 @@ backup="$stage/backup"
+mutation_started=0
+rollback_on_exit() {
+  local rc=$?
+  trap - EXIT ERR INT TERM
+  if (( rc != 0 && mutation_started == 1 )); then
+    printf '%s\n' 'Deployment failed; restoring backup.' >&2
+    if bash "$stage/ROLLBACK-AFTER-APPROVAL.sh"; then
+      printf '%s\n' 'Rollback completed.' >&2
+    else
+      printf '%s\n' 'ROLLBACK FAILED: manual recovery required; backup retained.' >&2
+    fi
+  fi
+  exit "$rc"
+}
+trap rollback_on_exit EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
